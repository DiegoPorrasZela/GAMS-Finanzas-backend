# Copia este archivo como ".env" y completa los valores. ".env" NO se sube a GitHub.
# Los valores por defecto de lo que no pongas están en src/main/resources/application.properties.

# Base de datos (ejemplo con Neon; para PostgreSQL local: jdbc:postgresql://localhost:5432/gams_finanzas)
DB_URL=jdbc:postgresql://ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=

# Opcionales
# CORS_ORIGENES=http://localhost:4200
# ADMIN_EMAIL=admin@gams.pe
# ADMIN_PASSWORD=admin123
# DEMO_PASSWORD=demo123
